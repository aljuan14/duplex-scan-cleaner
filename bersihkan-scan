#!/usr/bin/env bash
# Pembersih Scan: jalankan di latar belakang lalu buka browser.
#   bersihkan-scan               -> mulai (atau buka kalau sudah jalan)
#   bersihkan-scan stop          -> matikan
#   bersihkan-scan --no-browser  -> mulai tanpa membuka browser
APP="$(dirname "$(readlink -f "$0")")"
URL="http://127.0.0.1:8765"
LOG="${XDG_CACHE_HOME:-$HOME/.cache}/pembersih-scan.log"
ping() { curl -s -o /dev/null --max-time 1 "$URL/api/ping"; }
stop() { curl -s -X POST -d '{}' --max-time 2 "$URL/api/shutdown" >/dev/null; for _ in $(seq 25); do ping || return 0; sleep 0.2; done; }
# versi file aplikasi saat ini (sama dengan perhitungan di server.py)
current() { python3 -c "import pathlib,sys;print(max(int(f.stat().st_mtime) for f in pathlib.Path(sys.argv[1]).iterdir() if f.suffix in ('.py','.html','.css')))" "$APP"; }

if [ "$1" = "stop" ]; then
  if ping; then stop; echo "Pembersih Scan dimatikan."
  else echo "Pembersih Scan tidak sedang berjalan."; fi
  exit 0
fi

if ping; then
  running=$(curl -s --max-time 1 "$URL/api/ping" | python3 -c "import json,sys;print(json.load(sys.stdin).get('version',''))" 2>/dev/null)
  if [ "$running" != "$(current)" ]; then
    echo "Aplikasi diperbarui, menyalakan ulang server…"
    stop
  fi
fi

if ! ping; then
  mkdir -p "$(dirname "$LOG")"
  setsid nohup python3 "$APP/server.py" --no-browser >"$LOG" 2>&1 &
  for _ in $(seq 30); do ping && break; sleep 0.2; done
  if ! ping; then echo "Gagal menjalankan Pembersih Scan. Lihat log: $LOG"; exit 1; fi
fi
echo "Pembersih Scan berjalan di $URL (matikan: bersihkan-scan stop)"
[ "$1" = "--no-browser" ] || xdg-open "$URL" >/dev/null 2>&1 &
